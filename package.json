{
  "name": "zhishi",
  "version": "0.1.0",
  "private": true,
  "description": "知拾：本地优先的个人错题卡片工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm check:files && pnpm test && pnpm build",
    "check:files": "node scripts/check-file-size.mjs",
    "preview": "vite preview",
    "test": "node scripts/check-file-size.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-dialog": "latest",
    "@tanstack/react-query": "latest",
    "@tauri-apps/api": "latest",
    "clsx": "latest",
    "katex": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-markdown": "latest",
    "react-router-dom": "latest",
    "rehype-katex": "latest",
    "rehype-sanitize": "latest",
    "remark-math": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/katex": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@11.5.1"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "coreMethod": {
      "type": "string",
      "maxLength": 400,
      "description": "仅针对指定知识点的极简核心方法，最多两句，不写题目答案或相邻知识点。"
    },
    "mistakeReminder": {
      "type": "string",
      "maxLength": 240,
      "description": "依据来源错题实际错误提炼的简短个人提醒；证据不足时明确说明。"
    },
    "warnings": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "maxLength": 200 }
    }
  },
  "required": ["coreMethod", "mistakeReminder", "warnings"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "sourceCardIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "question": { "type": "string", "maxLength": 1200 },
          "correctAnswer": { "type": "string", "maxLength": 1200 },
          "solution": { "type": "string", "maxLength": 2400 }
        },
        "required": ["sourceCardIds", "question", "correctAnswer", "solution"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cards"],
  "additionalProperties": false
}
